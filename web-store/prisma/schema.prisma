generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW              @map("new")
  PROCESSING       @map("processing")
  CONFIRMED        @map("confirmed")
  SENT_TO_SUPPLIER @map("sent_to_supplier")
  SUPPLIER_ERROR   @map("supplier_error")
  COMPLETED        @map("completed")
  CANCELLED        @map("cancelled")
}

enum StorefrontRole {
  B2C @map("b2c")
  B2B @map("b2b")
  GOV @map("gov")
}

enum RoleRequestStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String?
  role         StorefrontRole       @default(B2C)
  phone        String?
  orgName      String?
  inn          String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  sessions     Session[]
  roleRequests RoleUpgradeRequest[]
  orders       Order[]
  leads        Lead[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}

model MagicLinkToken {
  id         String    @id @default(cuid())
  email      String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model RoleUpgradeRequest {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedRole StorefrontRole
  status        RoleRequestStatus @default(PENDING)
  orgName       String
  inn           String?
  contactPerson String
  phone         String
  note          String?
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime          @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

model Category {
  id             String     @id @default(cuid())
  externalId     Int        @unique
  parentId       String?
  parent         Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryChildren")
  name           String
  slug           String     @unique
  isLeaf         Boolean    @default(false)
  isActive       Boolean    @default(true)
  isVisible      Boolean    @default(true)
  seoTitle       String?
  seoDescription String?
  description    String?
  sortOrder      Int        @default(0)
  products       Product[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([parentId])
  @@index([externalId, isActive, isVisible])
}

model Product {
  id                 String         @id @default(cuid())
  sku                Int            @unique
  categoryId         String?
  category           Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryExternalId Int?
  supplierName       String
  name               String?
  slug               String         @unique
  vendor             String?
  part               String?
  barcodes           String?
  rrp                Decimal?       @db.Decimal(12, 2)
  supplierPrice      Decimal?       @db.Decimal(12, 2)
  retailPrice        Decimal?       @db.Decimal(12, 2)
  manualPrice        Decimal?       @db.Decimal(12, 2)
  stockStatus        String         @default("out")
  nearestStockStatus String?
  isAvailable        Boolean        @default(false)
  deliveryDays       Int            @default(0)
  multiplicity       Int            @default(1)
  hasImage           Boolean        @default(false)
  warranty           String?
  weight             Float?
  volume             Float?
  isActive           Boolean        @default(true)
  isVisible          Boolean        @default(true)
  seoTitle           String?
  seoDescription     String?
  description        String?
  specifications     Json?
  sourceUpdatedAt    DateTime?
  images             ProductImage[]
  attributes         ProductAttribute[]
  orderItems         OrderItem[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([categoryId, isActive, isVisible])
  @@index([categoryExternalId])
  @@index([vendor])
  @@index([slug])
  @@index([sku])
  @@index([isAvailable, retailPrice])
}

model ProductAttribute {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key             String
  label           String
  value           String
  normalizedValue String
  numericValue    Float?
  unit            String?
  source          String   @default("name")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, key, normalizedValue, source])
  @@index([productId])
  @@index([key, normalizedValue])
  @@index([key, numericValue])
  @@index([source, updatedAt])
}

model ProductImage {
  id              String   @id @default(cuid())
  supplierImageId Int?     @unique
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             Int
  supplierImageUrl String
  localImageUrl   String?
  priority        Int      @default(100)
  deleted         Boolean  @default(false)
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sku, deleted, priority])
  @@index([productId, deleted, priority])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerName    String
  phone           String
  email           String?
  comment         String?
  status          OrderStatus @default(NEW)
  total           Decimal     @db.Decimal(12, 2)
  supplierOrderId String?
  supplierStatus  String?
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([userId, createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku           Int
  name          String
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  supplierPrice Decimal? @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)

  @@index([sku])
  @@index([orderId])
}

model SyncLog {
  id         String    @id @default(cuid())
  type       String
  status     String
  message    String?
  total      Int       @default(0)
  processed  Int       @default(0)
  failed     Int       @default(0)
  commandId  Int?
  payload    Json?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([type, startedAt])
  @@index([status, startedAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Warehouse {
  id         String   @id @default(cuid())
  externalId Int      @unique
  name       String
  isDefault  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  externalId Int      @unique
  address    String
  updatedAt  DateTime @updatedAt
}

enum LeadType {
  CALLBACK     @map("callback")
  QUOTE        @map("quote")
  STOCK_ALERT  @map("stock_alert")
}

enum LeadStatus {
  NEW     @map("new")
  HANDLED @map("handled")
}

/// Callback / quote requests captured durably so a lead is never lost if the
/// Telegram notification is unavailable. Telegram is sent best-effort after
/// the row is persisted.
model Lead {
  id        String     @id @default(cuid())
  type      LeadType
  status    LeadStatus @default(NEW)
  name      String
  phone     String
  email     String?
  company   String?
  inn       String?
  scope     String?
  context   String?
  comment   String?
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@index([status, createdAt])
  @@index([userId])
}
