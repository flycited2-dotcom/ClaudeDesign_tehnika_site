DATABASE_URL="postgresql://user:password@localhost:5432/shop_db?schema=public&connection_limit=20&pool_timeout=30"

SITE_URL="https://example.ru"

ITP_API_BASE_URL="https://b2b.i-t-p.pro"
ITP_API_RPC_URL="https://b2b.i-t-p.pro/api/2"
ITP_API_LOGIN=""
ITP_API_PASSWORD=""

ITP_SYNC_CATEGORIES_ENABLED="true"
ITP_SYNC_PRODUCTS_ENABLED="true"
ITP_SYNC_PRICES_ENABLED="true"
ITP_SYNC_IMAGES_ENABLED="true"
ITP_ORDER_CREATE_ENABLED="false"

ITP_DEFAULT_MARKUP_PERCENT="25"
ITP_MIN_PRICE_MARKUP_RUB="300"
ITP_IMAGE_SIZE="large"

TELEGRAM_BOT_TOKEN=""
TELEGRAM_MANAGER_CHAT_ID=""

# Urgent supplier stock monitoring. Prefer exact SKU values; name/series
# patterns are matched case-insensitively against the local product catalog.
STOCK_MONITOR_SKUS=""
STOCK_MONITOR_PATTERNS=""
STOCK_MONITOR_REPEAT_MINUTES="15"
STOCK_MONITOR_ERROR_REPEAT_MINUTES="60"
STOCK_MONITOR_NOTIFY_OUT_OF_STOCK="false"
STOCK_MONITOR_B2B_URL="https://b2b.i-t-p.pro"
# Hard watchdog for a hung check. systemd restarts failed/timed-out runs.
STOCK_MONITOR_MAX_RUNTIME_SECONDS="240"
STOCK_MONITOR_KILL_AFTER_SECONDS="30"
# Optional dedicated Telegram destination; leaves order notifications untouched.
STOCK_MONITOR_TELEGRAM_BOT_TOKEN=""
STOCK_MONITOR_TELEGRAM_CHAT_ID=""
# Optional. Default: .runtime/stock-monitor-state.json
STOCK_MONITOR_STATE_FILE=""
# Interactive Telegram ordering. The bot creates an editable B2B order and
# adds the requested SKU, but never confirms it for shipment automatically.
STOCK_ORDER_BOT_ENABLED="false"
# Optional allow-list of Telegram user IDs. Empty means every member of the
# configured Telegram chat can start an order; only its author can confirm it.
STOCK_ORDER_TELEGRAM_USER_IDS=""
# Supplier logistic-center ID. For the Crimea account this is 16.
STOCK_ORDER_LOGISTIC_CENTER_ID=""
# Saved delivery address from I-T-P get_addresses. Type 2 (delivery) is set
# automatically when this ID is configured.
STOCK_ORDER_DELIVERY_ADDRESS_ID=""
STOCK_ORDER_DELIVERY_ADDRESS_LABEL=""
# Direct link back to the private stock-monitoring chat. For a private
# supergroup use https://t.me/c/<chat id without -100>/1.
STOCK_ORDER_TELEGRAM_CHAT_URL=""
STOCK_ORDER_CONFIRM_TTL_MINUTES="5"
# Random secret passed by Telegram in X-Telegram-Bot-Api-Secret-Token.
STOCK_ORDER_TELEGRAM_WEBHOOK_SECRET=""
# Signed browser fallback for networks where Telegram cannot deliver webhooks.
STOCK_ORDER_LINK_SECRET=""
STOCK_ORDER_LINK_TTL_MINUTES="60"

ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET="change-me-before-production"

# Shared secret for POST /api/admin/revalidate — the bulk sync scripts
# (scripts/sync-*.ts) call it as their last step so catalog caches refresh
# right after a sync, instead of waiting for the periodic cache warmer.
REVALIDATE_SECRET="change-me-before-production"

# User auth (magic-link email login for /account, /b2b, /gov).
#
# Mail delivery, in order of preference (see src/lib/mailer.ts):
#   1. SMTP — production path. Phase 1 uses a self-hosted Postfix relay on the
#      VPS: SMTP_HOST=127.0.0.1, SMTP_PORT=25, no auth (Postfix accepts from
#      mynetworks=127.0.0.0/8). Leave SMTP_USER/SMTP_PASSWORD empty for that.
#      For an authenticated external relay instead, fill user+password.
#   2. Resend (RESEND_API_KEY) — legacy fallback.
#   3. Console — dev fallback (prints to logs), if nothing above is set.
SMTP_HOST="127.0.0.1"
SMTP_PORT="25"
SMTP_USER=""
SMTP_PASSWORD=""
# Senders: noreply@ for transactional (login/registration), info@ for informational.
MAIL_FROM_NOREPLY="БытТехОпт <noreply@climat-simf.ru>"
MAIL_FROM_INFO="БытТехОпт <info@climat-simf.ru>"
# Legacy single-sender fallback (still honored by mailFromNoreply if the above is unset).
MAIL_FROM="БытТехОпт <noreply@climat-simf.ru>"
RESEND_API_KEY=""

WEB_STORE_VPS_HOST="212.116.115.150"
WEB_STORE_VPS_USER="root"
WEB_STORE_VPS_REMOTE_ROOT="/var/www/climat-simf.ru"
WEB_STORE_PM2_PROCESS="climat-simf-store"
WEB_STORE_PUBLIC_URL="https://climat-simf.ru"
WEB_STORE_SSH_KEY_PATH=""
# Set locally only, never commit real value:
# WEB_STORE_VPS_PASSWORD=""
