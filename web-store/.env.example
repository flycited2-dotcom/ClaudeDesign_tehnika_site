ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET="change-me-before-production"

# User auth (magic-link email login for /account, /b2b, /gov).
#
# Mail delivery, in order of preference (see src/lib/mailer.ts):
#   1. SMTP — production path. Phase 1 uses a self-hosted Postfix relay on the
#      VPS: SMTP_HOST=127.0.0.1, SMTP_PORT=25, no auth (Postfix accepts from
#      mynetworks=127.0.0.0/8). Leave SMTP_USER/SMTP_PASSWORD empty for that.
#      For an authenticated external relay instead, fill user+password.
#   2. Resend (RESEND_API_KEY) — legacy fallback.
#   3. Console — dev fallback (prints to logs), if nothing above is set.
SMTP_HOST="127.0.0.1"
SMTP_PORT="25"
SMTP_USER=""
SMTP_PASSWORD=""
# Senders: noreply@ for transactional (login/registration), info@ for informational.
MAIL_FROM_NOREPLY="БытТехОпт <noreply@climat-simf.ru>"
MAIL_FROM_INFO="БытТехОпт <info@climat-simf.ru>"
# Legacy single-sender fallback (still honored by mailFromNoreply if the above is unset).
MAIL_FROM="БытТехОпт <noreply@climat-simf.ru>"
RESEND_API_KEY=""

WEB_STORE_VPS_HOST="212.116.115.150"
WEB_STORE_VPS_USER="root"
WEB_STORE_VPS_REMOTE_ROOT="/var/www/climat-simf.ru"
WEB_STORE_PM2_PROCESS="climat-simf-store"
WEB_STORE_PUBLIC_URL="https://climat-simf.ru"
WEB_STORE_SSH_KEY_PATH=""
# Set locally only, never commit real value:
# WEB_STORE_VPS_PASSWORD=""
